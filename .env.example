# Copy to .env. Never commit your real .env.
TELEGRAM_BOT_TOKEN=
# Public channel: @your_channel. Private channel: its -100... numeric chat ID.
TELEGRAM_CHAT_ID=
NOTIFY_SCRAPE_SUMMARY=true

# Schedule: 00:00, 06:00, 12:00, 18:00 in this timezone.
TZ=Asia/Bangkok
# Weekly Sunday 03:00 cleanup removes history older than this many days.
RETENTION_DAYS=30

# Dashboard: http://localhost:8080
PORT=8080
BIND_ADDRESS=127.0.0.1
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Optional comma-separated location names to add to APAC detection.
APAC_EXTRA_KEYWORDS=
